previa.fernandagabriela.com {
  tls {
    issuer acme
  }
  header {
    X-Robots-Tag "noindex, nofollow, noarchive"
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options SAMEORIGIN
    -Server
  }
  redir /admin https://admin.fernandagabriela.com/ permanent
  @adminPages path /admin/*
  redir @adminPages https://admin.fernandagabriela.com{uri} permanent
  @internal path /api/internal /api/internal/*
  respond @internal 404
  # These endpoints require the dedicated Bearer token at the API.
  @gateway path /api/i18n/translate /api/i18n/settings
  handle @gateway {
    reverse_proxy 127.0.0.1:7153
  }
  handle {
    basic_auth {
      fernanda REPLACE_WITH_CADDY_PASSWORD_HASH
    }
    handle /api/* {
      request_body {
        max_size 106MB
      }
      reverse_proxy 127.0.0.1:7153
    }
    handle {
      reverse_proxy 127.0.0.1:7154
    }
  }
  encode zstd gzip
}
