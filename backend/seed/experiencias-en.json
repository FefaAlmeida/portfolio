            "i18nId": "contribution"
          },
          "content": [
            {
              "type": "text",
              "text": "I assign stories, track deadlines and review drafts. Over the course of my involvement, I supervised "
            },
            {
              "type": "text",
              "text": "6 contributors",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "text",
              "text": " and have "
            },
            {
              "type": "text",
              "text": "15+ articles published",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "text",
              "text": " on the project’s website and Instagram. I also produced "
            },
            {
              "type": "text",
              "text": "2 videos",
              "marks": [
                {
                  "type": "bold"
                }
              ]
            },
            {
              "type": "text",
              "text": ", wrote scripts for teammates and promoted VAF at SESI and among MatMov students."
            }
          ]
        }
      ]
    },
