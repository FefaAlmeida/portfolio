NODE_ENV=development
PORT=3001
PUBLIC_URL=http://localhost:3000
# Set a separate origin only when hosting the administration on a subdomain.
ADMIN_URL=http://localhost:3000
DATABASE_PATH=./data/portfolio.sqlite
BACKUP_DIR=./data/backups
BACKUP_SCHEDULE=0 3 * * *
S3_ENDPOINT=http://127.0.0.1:19000
S3_REGION=us-east-1
S3_BUCKET=portfolio
S3_ACCESS_KEY_ID=portfolio-dev
S3_SECRET_ACCESS_KEY=portfolio-local-only-password
OPERATIONS_TOKEN=local-development-operations-token-change-in-production
API_BASE_URL=http://127.0.0.1:3001

# Development sends translations to the production authority (no local Gemini key).
I18N_GATEWAY_URL=https://SEU-DOMINIO
I18N_SYNC_TOKEN=SUBSTITUA_PELO_TOKEN_DE_TRADUCAO_DE_PRODUCAO
# Conservative BRL/USD rate used when reserving the annual budget.
I18N_USD_BRL_RATE=7
