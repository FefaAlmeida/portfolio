{
  "name": "portfolio-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node scripts/check.js",
    "admin": "node --env-file-if-exists=.env src/cli.js admin",
    "seed": "node --env-file-if-exists=.env src/cli.js seed",
    "i18n:backfill": "node --env-file-if-exists=.env src/cli.js i18n:backfill",
    "backup": "node --env-file-if-exists=.env src/cli.js backup",
    "restore": "node --env-file-if-exists=.env src/cli.js restore",
    "migrate": "node --env-file-if-exists=.env src/cli.js migrate",
    "test:storage": "node --env-file-if-exists=.env --test test/storage.integration.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.1.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "proper-lockfile": "^4.1.2",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.0"
  }
}
